# Copy this file to .env and fill in your own values.
# .env is gitignored and will never be committed.

# --- Database backend ---
# "sqlite" (default, no setup needed) or "sqlserver"
DB_BACKEND=sqlite

# Only used when DB_BACKEND=sqlite
SQLITE_PATH=crypto_pipeline.db

# Only used when DB_BACKEND=sqlserver
SQLSERVER_HOST=.
SQLSERVER_DATABASE=CryptoPipelineDB
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server

# --- API keys ---
# Required only for coingecko_price_history.py (CoinGecko Pro).
# Get one at https://www.coingecko.com/en/api/pricing
# defillama_coin_prices.py is a free alternative that needs no key.
COINGECKO_API_KEY=your_coingecko_pro_api_key_here
